# Firebase Web app config — these values are public client configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-side AI proxy secret. Do not expose with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional; must only be enabled for a local emulator workflow.
# Never define this in Antideploy production.
# FIRESTORE_EMULATOR_HOST=
