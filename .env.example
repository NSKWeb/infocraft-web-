# Firebase Web app config — browser-visible by design; protect data with Auth + Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-side AI secret. Never expose with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Cloudflare Workers AI — primary image provider for Poster Studio (FLUX.1 Schnell).
# Create a token with Workers AI permissions. Keep both values server-side.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional paid Gemini image-generation backup for Poster Studio only.
# Default OFF. Set to true only if you accept possible Gemini image-generation charges.
# Requires GEMINI_API_KEY. Other Gemini features are not affected by this flag.
POSTER_GEMINI_FALLBACK_ENABLED=false

# Optional search grounding is handled by the Gemini API route.
# Deploy firestore.rules to the Firebase project before enabling cloud saves.

# Shared production API rate limiting (Upstash Redis REST).
# Required in production on Vercel, Netlify, Antideploy and VPS.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
